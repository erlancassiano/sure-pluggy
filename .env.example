# Credenciais e URLs — preencha localmente; nunca commite o .env
PLUGGY_CLIENT_ID=seu-client-id
PLUGGY_CLIENT_SECRET=seu-client-secret
PLUGGY_ITEM_IDS=item-id-1,item-id-2

SURE_API_KEY=sua-chave-api-sure
# Em Docker na mesma rede do Sure: http://web:3000
# Em Docker apontando para o host Windows: http://host.docker.internal:3001
# No host Windows direto: http://localhost:3001
SURE_URL=http://localhost:3001

SYNC_LOOKBACK_DAYS=15
SYNC_STATE_PATH=./state.sqlite
SYNC_RULES_PATH=./rules.yaml
SYNC_ACCOUNTS_MAP_PATH=./accounts_map.json
LOG_LEVEL=INFO
LOG_AMOUNTS=false
